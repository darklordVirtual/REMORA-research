__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Local caches (oracle responses, ablation, research, thermo router eval)
.remora_cache*.json
.ablation_cache.json
.research_cache.json
.thermo_router_eval_cache.json

# Smoke-test scratch artifacts (kept under results/ during development)
results/_smoke_*.json

# Shadow-replay output — scripts/shadow_replay.py writes here by default; the
# Quickstart / reproducibility docs tell readers to run it, so ignore the
# generated run output (never an artifact-of-record — those live under results/).
artifacts/shadow_mode/

# Test attestation is generated per-commit (CI review-* tags or locally via
# scripts/generate_test_attestation.py); a committed copy is stale by
# construction. See artifacts/credibility-pack/ATTESTATION.md.
artifacts/credibility-pack/test-attestation.json
artifacts/credibility-pack/test-report.txt

# Literature extract scratch files (never committed; move to docs/archive/ if needed)
_*_extract.txt
_*_paper*.txt

# Internal review notes — the files themselves state "gitignored, do not push".
# To publish one: remove that marker, register it in the document register.
docs/archive/code_reviews/

# Node / wrangler — node_modules is installed by CI (npm install), never committed
node_modules/
frontend/node_modules/
.wrangler/
workers/*/dist-check/

# Logs and secrets
*.log
hotpotqa_yesno.json
.env
*.key
.env.vars
.claude/settings.local.json
.remora_session/
docs/superpowers/
.codex_tmp/
.codex/config.toml
.env.vars

# Python virtual environments
.venv/
.venv-*/
venv/

# LaTeX build artifacts
*.aux
*.out
*.toc
*.synctex.gz

# CodeGraph local index
.codegraph/

# Private and internal files — must not be pushed
internal_*
/CODE_REVIEW*.md
_*extract*.txt
_*detail*.txt

# Academic reference PDFs in the repository root (copyright, not redistributable)
/*.pdf
# Internal working documents — reference material, not for publication
docs/researchpapers/kompendium_ai_assurance_3utgave.md

# MkDocs build output
/site/

# Root-level scratch/extraction files (working notes, not for the repo)
/_*.txt

# Build artifacts must not be committed
*.whl

# Mypy temp output
mypy_errors.txt
