# Shadow-replay output — scripts/shadow_replay.py writes here by default; the
# Quickstart / reproducibility docs tell readers to run it, so ignore the
# generated run output (never an artifact-of-record — those live under results/).
artifacts/shadow_mode/

# Test attestation is generated per-commit (CI review-* tags or locally via
# scripts/generate_test_attestation.py); a committed copy is stale by
# construction. See artifacts/credibility-pack/ATTESTATION.md.
artifacts/credibility-pack/test-attestation.json
artifacts/credibility-pack/test-report.txt

# Literature extract scratch files (never committed; move to docs/archive/ if needed)
_*_extract.txt
_*_paper*.txt

# Internal review notes — the files themselves state "gitignored, do not push".
# To publish one: remove that marker, register it in the document register.
docs/archive/code_reviews/

# Node / wrangler — node_modules is installed by CI (npm install), never committed
node_modules/
frontend/node_modules/
.wrangler/
workers/*/dist-check/

