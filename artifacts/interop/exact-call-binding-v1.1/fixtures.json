{
  "schema_version": "remora-exact-call-binding-fixtures-v1.1",
  "source_revision": "537a1a123932bf93bb2a28786ce67d426d671739",
  "claims": [
    "exact_call_binding",
    "single_use_authorization"
  ],
  "result_vocabulary": [
    "ESTABLISHED",
    "CONTRADICTED",
    "NOT_ESTABLISHED"
  ],
  "outcome_vocabulary": [
    "DISPATCHED",
    "REFUSED"
  ],
  "refusal_classes": {
    "call_mismatch": "the presented call differs from the authorized call in tool, arguments, tenant or target",
    "principal_mismatch": "the presented principal differs from the one the authorization was issued to",
    "authority_consumed": "the authorization was already spent by an earlier dispatch",
    "authority_unverifiable": "the authorization is unsigned or its signature does not verify"
  },
  "claim_ceiling": "ESTABLISHED means only that, under this fixture contract, an authorization dispatches exactly the call it was issued for and at most once, with integer and float, bool and integer, and absent and null kept apart. It does not establish correct semantic intent, that an external effect occurred, that every path to the tool passes through the enforcement point, that a call object mutated after the binding check is refused (a static corpus cannot express post-verification mutation), or production deployment safety.",
  "canonical_form": "Arguments are compared by canonical content: object member order is irrelevant, array order and scalar types are significant. The integer 1 and the float 1.0 are different scalars, true is not 1, an absent argument is not an argument with value null, and integers are exact at any magnitude. The fixture does not prescribe a hash algorithm.",
