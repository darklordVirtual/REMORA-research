  "schema_version": "remora-exact-call-binding-fixtures-v1",
  "source_revision": "e6d41c71e95a7ae07f349c28e791e99bde0b9a5a",
  "claims": [
    "exact_call_binding",
    "single_use_authorization"
  ],
  "result_vocabulary": [
    "ESTABLISHED",
    "CONTRADICTED",
    "NOT_ESTABLISHED"
  ],
  "outcome_vocabulary": [
    "DISPATCHED",
    "REFUSED"
  ],
  "refusal_classes": {
    "call_mismatch": "the presented call differs from the authorized call in tool, arguments, tenant or target",
    "principal_mismatch": "the presented principal differs from the one the authorization was issued to",
    "authority_consumed": "the authorization was already spent by an earlier dispatch",
    "authority_unverifiable": "the authorization is unsigned or its signature does not verify"
  },
  "claim_ceiling": "ESTABLISHED means only that, under this fixture contract, an authorization dispatches exactly the call it was issued for and at most once. It does not establish correct semantic intent, that an external effect occurred, that every path to the tool passes through the enforcement point, or production deployment safety.",
  "canonical_form": "Arguments are compared by canonical content: object member order is irrelevant, array order and scalar types are significant. The fixture does not prescribe a hash algorithm.",
