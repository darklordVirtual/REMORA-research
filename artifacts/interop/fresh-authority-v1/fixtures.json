  ],
  "result_vocabulary": [
    "ESTABLISHED",
    "CONTRADICTED",
    "NOT_ESTABLISHED"
  ],
  "stages": {
    "grant": "a policy decision redeemed at the enforcement point",
    "dispatch": "an execution lease presented to the governed dispatcher"
  },
  "outcome_vocabulary": [
    "ADMITTED",
    "DISPATCHED",
    "REFUSED"
  ],
  "refusal_classes": {
    "authority_expired": "presented at or after expires_at",
    "authority_not_yet_valid": "presented before issued_at",
    "authority_revoked": "the signing key was revoked after issue",
    "authority_stale": "the observation, policy bundle or tool definition at presentation differs from the one at issue",
    "authority_consumed": "already redeemed",
    "decision_not_accept": "the decision was not an acceptance",
    "authority_unverifiable": "unsigned or signature invalid"
  },
  "claim_ceiling": "ESTABLISHED means only that, under this fixture contract, an authorization is re-evaluated at the moment it is used and does not survive expiry, revocation, consumption or a change of observation, policy bundle or tool definition. It does not establish that the clock at the enforcement point is trustworthy, that revocation lists propagate in bounded time, that every execution path passes through the enforcement point, or production deployment safety.",
