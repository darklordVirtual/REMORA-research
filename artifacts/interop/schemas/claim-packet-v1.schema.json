{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REMORA interoperability claim packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer",
    "producer_revision",
    "source_revision",
    "artifact_refs",
    "claims",
    "assumptions",
    "explicit_non_claims",
    "temporal_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "remora-claim-packet-v1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "const": "REMORA-research"
    },
    "producer_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "id"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "result_vocabulary",
          "claim_ceiling"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "result_vocabulary": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temporal_scope": {
      "type": "string",
      "minLength": 1
    }
  }
}
