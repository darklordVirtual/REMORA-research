# REMORA pilot pack: bounded shadow-mode deployment configuration.
# Used with the container reference deployment (deploy/reference/):
#   docker compose -f deploy/reference/docker-compose.yml --env-file \
#     artifacts/pilot-pack/example-config/shadow-mode.env up
#
# Shadow mode = observer-only (protocol precondition 7): the assess surface
# and the review queue run; no live enforcement against partner systems.

# ── profile ────────────────────────────────────────────────────────────────
# development refuses nothing; production refuses to start without real
# keys and durable state. A pilot runs development-profile SHADOW ONLY.
REMORA_ENV=development

# ── bounded scope (precondition 3) ─────────────────────────────────────────
# The partner's registry module: ONLY the named tools exist. Copy
# partner_tool_registry.py, adapt, and mount it into the image.
REMORA_TOOL_REGISTRY_MODULE=pilot.partner_tool_registry

# ── durable audit (reporting) ──────────────────────────────────────────────
# DecisionEnvelopes and execution state must survive restarts, or the
# missing-audit-data criterion in the worksheet cannot be measured honestly.
REMORA_PG_DSN=postgresql://remora:CHANGE-ME@postgres:5432/remora
REMORA_CONTROL_PLANE_DSN=postgresql://remora:CHANGE-ME@postgres:5432/remora
POSTGRES_PASSWORD=CHANGE-ME

# ── signing (set real values; placeholders will not survive review) ───────
REMORA_PDP_SIGNING_KEY=CHANGE-ME
REMORA_LEASE_SIGNING_KEY=CHANGE-ME
REMORA_ENVELOPE_SIGNING_KEY=CHANGE-ME
