    },
    "reference_image": {
      "dockerfile": "deploy/reference/Dockerfile",
      "base_image": "python:3.12-slim",
      "base_digest": "sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17"
    },
    "image": null,
    "image_reason": "No REMORA container image is published to any registry. deploy/reference/Dockerfile builds one locally from the wheel on top of the digest-pinned base above; the CI container-contract job builds it on every push but does not push it. There is therefore no image digest to pin, and none is claimed."
  },
  "does_not_verify": [
    "Live results (results manifest class live) that need API keys, a Cloudflare worker or network access.",
    "Imported historical results beyond their hash and recorded fields: the pack cannot re-run them here.",
