# Development credentials for the reference topology (deploy/reference).
# Copy to .env next to docker-compose.yml before `docker compose up`.
# Generate a fresh token for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REMORA_API_TOKENS={"remora-dev-token-change-me":{"tenant":"default","role":"operator"}}
POSTGRES_PASSWORD=remora-dev-only
