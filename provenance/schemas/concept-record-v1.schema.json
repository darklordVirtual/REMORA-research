{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REMORA concept record v1",
  "description": "One entry in the provenance ledger: a concept with a permanent id, its first recorded appearance, the documents, code and tests that express it, and its prior-art status. Registration records priority and content; it is not a claim of invention.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "concept_id", "canonical_name", "invariant", "identifying_terms", "origin", "classification", "first_recorded", "canonical_spec", "implementation", "tests", "conformance", "interop_contracts", "related_capabilities", "related_claims", "federation_produces", "distinguishing_contribution", "prior_art", "evolution", "external_adoption", "license"],
  "properties": {
    "schema_version": {"const": "remora-concept-record-v1"},
    "concept_id": {"type": "string", "pattern": "^PROV-[0-9]{2}$"},
    "canonical_name": {"type": "string", "minLength": 1},
    "invariant": {"type": "string", "minLength": 1},
    "identifying_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["authors", "project", "status"],
      "properties": {
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "project": {"const": "REMORA"},
        "status": {"enum": ["claimed_original_contribution", "reviewed_original_contribution", "compositional_contribution", "derived"]}
      }
    },
    "classification": {"enum": ["ORIGINAL_CLAIM", "PRIOR_ART_OVERLAP", "COMPOSITIONAL_CONTRIBUTION", "IMPLEMENTATION_INNOVATION", "TERMINOLOGY_ONLY", "DERIVED", "KNOWN_PRIOR_ART", "RELATED_PRIOR_ART", "INDEPENDENT_CONVERGENCE", "REMORA_EXTENSION", "REMORA_COMPOSITION", "POTENTIALLY_DISTINCT", "NOT_ENOUGH_EVIDENCE", "UNKNOWN"]},
    "first_recorded": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "authored", "committed", "signature", "paths", "method"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "authored": {"type": "string", "minLength": 10},
        "committed": {"type": "string", "minLength": 10},
        "signature": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "items": {"type": "string"}},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "canonical_spec": {"$ref": "#/$defs/pathlist"},
    "implementation": {"$ref": "#/$defs/pathlist"},
    "tests": {"$ref": "#/$defs/pathlist"},
    "conformance": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interop_contracts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "related_capabilities": {"type": "array", "items": {"type": "string", "pattern": "^CAP-"}},
    "related_claims": {"type": "array", "items": {"type": "string", "pattern": "^CLAIM-[0-9]{3}$"}},
    "federation_produces": {"type": ["string", "null"]},
    "distinguishing_contribution": {"type": "string", "minLength": 20},
    "prior_art": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewed", "review_sources", "records", "note"],
      "properties": {
        "reviewed": {"type": "boolean"},
        "review_sources": {"type": "array", "items": {"type": "string", "pattern": "^PA-SRC-[0-9]{3}$"}},
        "records": {"type": "array", "items": {"type": "string", "pattern": "^PA-REV-[0-9]{3}$"}},
        "note": {"type": "string"}
      }
    },
    "evolution": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage", "commit", "date", "note"],
        "properties": {
          "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_adoption": {"type": "array", "items": {"type": "string", "pattern": "^EXT-[0-9]{4}$"}},
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["spdx", "licensor", "reference"],
      "properties": {"spdx": {"const": "BUSL-1.1"}, "licensor": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "pathlist": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}, "role": {"type": "string"}}}}
  },
  "allOf": [
    {"if": {"properties": {"classification": {"not": {"const": "UNKNOWN"}}}}, "then": {"properties": {"prior_art": {"properties": {"reviewed": {"const": true}, "records": {"minItems": 1}}}}}},
    {"if": {"properties": {"origin": {"properties": {"status": {"const": "reviewed_original_contribution"}}}}}, "then": {"properties": {"classification": {"enum": ["ORIGINAL_CLAIM", "IMPLEMENTATION_INNOVATION", "COMPOSITIONAL_CONTRIBUTION"]}}}}
  ]
}
