{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/REMORA-research/schemas/remora-federation-transport-capabilities-v1.json",
  "title": "REMORA federation transport capability declaration v1",
  "description": "What a transport can carry (remora.federation.capabilities). Only true supplies a capability; false and partial do not.",
  "type": "object",
  "required": [
    "schema_version",
    "transport",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "remora-federation-transport-capabilities-v1"
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "const": "partial"
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
